{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Human Workflow Operator",
  "version": "0.1.0",
  "identifier": "com.example.humanworkflowoperator",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "Human Workflow Operator",
        "width": 1280,
        "height": 900,
        "minWidth": 900,
        "minHeight": 650,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src 'self' https://tauri.localhost http://localhost:1420; style-src 'self' 'unsafe-inline'; img-src 'self' data:; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "macOS": {
      "minimumSystemVersion": "10.15"
    }
  },
  "plugins": {
    "opener": {
      "open": "^https?://(www\\.)?(youtube\\.com|youtu\\.be)/.*$"
    }
  }
}
